-- Small static binary (Alpine / musl).
-- Usage: cabal build --project-file=cabal.project.musl
import: cabal.project

package *
  split-sections: True
  executable-static: True
  optimization: 1
  ghc-options:
    -optl-Wl,--gc-sections
    -optl-s

-- the stemmers and the search engine build the index of the pages and the
-- keywords at each load
package snowball-c
  optimization: 2

package full-text-search
  optimization: 2
