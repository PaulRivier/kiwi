-- Mode développement

import: cabal.project

-- for local code
optimization: 0

--  dependencies keep the default optimization (-O1) so that cache
-- remain shared with every other builds and projects
package *
  optimization: 1

-- the stemmers and the search engine build the index of the pages and the
-- keywords at each load: optimized, as the other dependencies (snowball-c
-- is a local package, it would be built at -O0 as kiwi)
package snowball-c
  optimization: 1

package full-text-search
  optimization: 1
