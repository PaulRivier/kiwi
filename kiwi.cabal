cabal-version:      3.4

name:           kiwi
version:        0.3.0.0
synopsis:       Minimalist wiki/CMS based on CommonMark files
category:       Web
description:    Please see the README on GitHub at <https://github.com/PaulRivier/kiwi>
homepage:       https://github.com/PaulRivier/kiwi
bug-reports:    https://github.com/PaulRivier/kiwi
author:         Paul Rivier
maintainer:     Paul Rivier
copyright:      2020 Paul Rivier
license:        GPL-3.0-or-later
license-file:   LICENSE
build-type:     Simple
extra-doc-files:
    README.md
    ChangeLog.md
-- files embedded at compile time (file-embed)
extra-source-files:
    static/*.md
    static/*.default

source-repository head
  type: git
  location: https://github.com/PaulRivier/kiwi


common ghc-opts
  default-language:   GHC2021
  default-extensions: OverloadedStrings
  ghc-options:        -Wall -Wunused-packages
                      -Werror=incomplete-patterns
                      -Wcompat
                      -Wredundant-constraints

library
  import:  ghc-opts
  build-depends:
      aeson
    , async
    , base >=4.7 && <5
    , base16-bytestring
    , blaze-html
    , bytestring
    , commonmark
    , commonmark-extensions
    , commonmark-pandoc
    , config-ini
    , containers
    , crypton
    , directory
    , file-embed
    , filepath
    , full-text-search
    , http-types
    , mtl
    , optparse-applicative
    , pandoc-types
    , process
    , scotty
    , snowball
    , stache
    , text
    , time
    , unicode-transforms
    , unliftio-core
    , wai-extra
    , wai-middleware-static
  exposed-modules:
      Kiwi
      Kiwi.CLI
      Kiwi.ConfigFile
      Kiwi.Controller
      Kiwi.DefaultPages
      Kiwi.Locales
      Kiwi.HtmlWriter
      Kiwi.PagesDB
      Kiwi.Pandoc
      Kiwi.Search
      Kiwi.Server
      Kiwi.Types
      Kiwi.Utils
      Kiwi.View
      Utils.DocIndex
  other-modules: Paths_kiwi
  autogen-modules: Paths_kiwi
  hs-source-dirs: src

executable kiwi
  import:  ghc-opts
  build-depends: base >=4.7 && <5, kiwi
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:  -threaded


test-suite kiwi-test
  import:  ghc-opts
  build-depends:
      base >=4.7 && <5
    , containers
    , hspec
    , http-types
    , kiwi
    , pandoc-types
    , text
    , time
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
