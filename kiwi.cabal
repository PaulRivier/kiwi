cabal-version:      3.4

name:           kiwi
version:        0.4.5.0
synopsis:       Minimalist wiki/CMS based on CommonMark files
category:       Web
description:    Please see the README on GitHub at <https://github.com/PaulRivier/kiwi>
homepage:       https://github.com/PaulRivier/kiwi
bug-reports:    https://github.com/PaulRivier/kiwi/issues
author:         Paul Rivier
maintainer:     Paul Rivier
copyright:      2020 Paul Rivier
license:        GPL-3.0-or-later
license-file:   LICENSE
build-type:     Simple
extra-doc-files:
    README.md
    doc/AGENTS.md
    ChangeLog.md
-- files embedded at compile time (file-embed)
extra-source-files:
    README.md
    static/*.md
    static/*.default
    static/stopwords/*.txt
    static/stopwords/LICENSE
    static/themes/**/*.css
    static/themes/**/*.js
    static/themes/**/*.svg
    static/themes/**/*.ico
    static/themes/**/*.txt

source-repository head
  type: git
  location: https://github.com/PaulRivier/kiwi


common ghc-opts
  default-language:   GHC2021
  default-extensions: OverloadedStrings
  ghc-options:        -Wall -Wunused-packages
                      -Werror=incomplete-patterns
                      -Wcompat
                      -Wredundant-constraints

library
  import:  ghc-opts
  build-depends:
      async
    , aeson
    , base >=4.7 && <5
    , base16-bytestring
    , bytestring
    , case-insensitive
    , commonmark
    , commonmark-extensions
    , commonmark-pandoc
    , config-ini
    , containers
    , crypton
    , directory
    , file-embed
    , filepath
    , full-text-search
    , http-types
    , lucid2
    , megaparsec
    , mime-types
    , mtl
    , optparse-applicative
    , pandoc-types
    , process
    , scotty
    , snowball-c
    , text
    , time
    , unicode-transforms
    , unix
    , unliftio-core
    , wai
    , wai-extra
    , warp
  exposed-modules:
      Kiwi
      Kiwi.Auth
      Kiwi.Browse
      Kiwi.CLI
      Kiwi.ConfigFile
      Kiwi.Controller
      Kiwi.DefaultPages
      Kiwi.Edit
      Kiwi.Files
      Kiwi.Git
      Kiwi.Keywords
      Kiwi.LangDetect
      Kiwi.Locales
      Kiwi.Mcp
      Kiwi.Log
      Kiwi.Meta
      Kiwi.MetaScript
      Kiwi.HtmlWriter
      Kiwi.PagesDB
      Kiwi.Pandoc
      Kiwi.Search
      Kiwi.Server
      Kiwi.Tags
      Kiwi.Theme
      Kiwi.Types
      Kiwi.Url
      Kiwi.Utils
      Kiwi.View
      Kiwi.Write
      Kiwi.Api
      Kiwi.Api.Search
      Kiwi.Api.Text
      Utils.DocIndex
      Utils.WaiCall
  other-modules: Paths_kiwi
  autogen-modules: Paths_kiwi
  hs-source-dirs: src

executable kiwi
  import:  ghc-opts
  build-depends: base >=4.7 && <5, kiwi
  main-is: Main.hs
  hs-source-dirs: app
  -- all the cores (page loading, password hashes that do not stop the other
  -- requests), with the sequential garbage collector
  ghc-options:  -threaded -rtsopts "-with-rtsopts=-N -qg"


test-suite kiwi-test
  import:  ghc-opts
  build-depends:
      base >=4.7 && <5
    , aeson
    , bytestring
    , containers
    , directory
    , filepath
    , full-text-search
    , hspec
    , http-types
    , kiwi
    , lucid2
    , pandoc-types
    , process
    , QuickCheck
    , text
    , time
    , unix
    , wai
    , wai-extra
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Kiwi.ApiSpec
      Kiwi.AuthSpec
      Kiwi.BrowseSpec
      Kiwi.ConfigFileSpec
      Kiwi.ControllerSpec
      Kiwi.EditSpec
      Kiwi.FilesSpec
      Kiwi.GitSpec
      Kiwi.HtmlWriterSpec
      Kiwi.KeywordsSpec
      Kiwi.LangDetectSpec
      Kiwi.McpSpec
      Kiwi.MetaScriptSpec
      Kiwi.MetaSpec
      Kiwi.PagesDBSpec
      Kiwi.PandocSpec
      Kiwi.SearchSpec
      Kiwi.TagsSpec
      Kiwi.ViewSpec
      TestUtils
      Utils.DocIndexSpec
  hs-source-dirs: test
