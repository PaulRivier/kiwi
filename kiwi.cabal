cabal-version:      3.4

name:           kiwi
version:        0.4.1.0
synopsis:       Minimalist wiki/CMS based on CommonMark files
category:       Web
description:    Please see the README on GitHub at <https://github.com/PaulRivier/kiwi>
homepage:       https://github.com/PaulRivier/kiwi
bug-reports:    https://github.com/PaulRivier/kiwi/issues
author:         Paul Rivier
maintainer:     Paul Rivier
copyright:      2020 Paul Rivier
license:        GPL-3.0-or-later
license-file:   LICENSE
build-type:     Simple
extra-doc-files:
    README.md
    ChangeLog.md
-- files embedded at compile time (file-embed)
extra-source-files:
    README.md
    static/*.md
    static/*.default
    static/themes/**/*.css
    static/themes/**/*.js
    static/themes/**/*.svg
    static/themes/**/*.ico

source-repository head
  type: git
  location: https://github.com/PaulRivier/kiwi


common ghc-opts
  default-language:   GHC2021
  default-extensions: OverloadedStrings
  ghc-options:        -Wall -Wunused-packages
                      -Werror=incomplete-patterns
                      -Wcompat
                      -Wredundant-constraints

library
  import:  ghc-opts
  build-depends:
      async
    , base >=4.7 && <5
    , base16-bytestring
    , bytestring
    , commonmark
    , commonmark-extensions
    , commonmark-pandoc
    , config-ini
    , containers
    , crypton
    , directory
    , file-embed
    , filepath
    , full-text-search
    , http-types
    , lucid2
    , mime-types
    , mtl
    , optparse-applicative
    , pandoc-types
    , process
    , scotty
    , snowball-c
    , text
    , time
    , unicode-transforms
    , unix
    , unliftio-core
    , wai
    , wai-extra
    , wai-middleware-static
    , warp
  exposed-modules:
      Kiwi
      Kiwi.Auth
      Kiwi.Browse
      Kiwi.CLI
      Kiwi.ConfigFile
      Kiwi.Controller
      Kiwi.DefaultPages
      Kiwi.Edit
      Kiwi.LangDetect
      Kiwi.Locales
      Kiwi.Log
      Kiwi.Meta
      Kiwi.HtmlWriter
      Kiwi.PagesDB
      Kiwi.Pandoc
      Kiwi.Search
      Kiwi.Server
      Kiwi.Tags
      Kiwi.Theme
      Kiwi.Types
      Kiwi.Url
      Kiwi.Utils
      Kiwi.View
      Utils.DocIndex
  other-modules: Paths_kiwi
  autogen-modules: Paths_kiwi
  hs-source-dirs: src

executable kiwi
  import:  ghc-opts
  build-depends: base >=4.7 && <5, kiwi
  main-is: Main.hs
  hs-source-dirs: app
  -- all the cores (page loading, password hashes that do not stop the other
  -- requests), with the sequential garbage collector
  ghc-options:  -threaded -rtsopts "-with-rtsopts=-N -qg"


test-suite kiwi-test
  import:  ghc-opts
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , full-text-search
    , hspec
    , http-types
    , kiwi
    , lucid2
    , pandoc-types
    , QuickCheck
    , text
    , time
    , wai
    , wai-extra
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Kiwi.AuthSpec
      Kiwi.BrowseSpec
      Kiwi.ConfigFileSpec
      Kiwi.ControllerSpec
      Kiwi.EditSpec
      Kiwi.HtmlWriterSpec
      Kiwi.LangDetectSpec
      Kiwi.MetaSpec
      Kiwi.PagesDBSpec
      Kiwi.PandocSpec
      Kiwi.SearchSpec
      Kiwi.TagsSpec
      Kiwi.ViewSpec
      TestUtils
      Utils.DocIndexSpec
  hs-source-dirs: test
