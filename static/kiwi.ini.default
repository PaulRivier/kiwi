[kiwi]
# Give a name to this kiwi
name: My Kiwi
# Path to your content, either absolute or relative to this file folder  
content-directory: content
# Your favorite text editor command. File path will be added as last argument.
# Without editor (commented out or empty), page edition is disabled: there is no
# edit button.
# examples :  emacsclient -n -s kiwi   ///   gedit   ///   gvim
# editor: gedit
# Server port
port: 3456
# Address to listen on. 127.0.0.1: only this computer can reach kiwi (use it
# behind a reverse proxy too). Without it (commented out or empty), kiwi
# listens on all the network interfaces.
bind: 127.0.0.1
# Language of the web interface: english (default) | french
# (the language of the pages and of the search is the lang below)
ui-lang: english
# Do you want to display Toc : on | off | auto
toc: on
# Set to yes if kiwi is served through HTTPS (behind a reverse proxy for example):
# the session cookie will then only be sent over HTTPS connections.
# Keep to no if you access kiwi with plain HTTP, or login will not work.
secure-cookie: no
# When a page saved from the browser is in a git repository (and not ignored
# there), kiwi commits it: yes (default) | no
git-commit: yes

# built-in metadata default values
[metadata-default]
title: untitled
tags: untagged
# access : built-in special groups are 'admin' and 'public'
# You can use any groups you want here, comma-separated, each with its right
# on the pages: read (family or family:r), write (family:w) or admin
# (family:a); 'public' can only read
access: admin
# lang of the pages, for fulltext search. Use auto/english to detect it from
# the content (french, english, spanish), with english when detection fails.
# auto alone is the same as auto/english
lang: english

# If you want more metadata. Threshold is the minimum ratio of relevance that must
# be reached before the metadata is suggested in the metadata-browser.
# Types: text | int | date (YYYY-MM-DD) | bool (yes, true, 1 | no, false, 0)

# [metadata category]
# type: text
# threshold: 0
# 
# [metadata authors]
# type: text
# threshold: 0.8


# Settings for the pages of a source (a folder in your content directory).
# root-tag: some sources may be very specific, you may want to nest their tags
#   under a parent tag to preserve your browsing experience
# access: default access of the pages, instead of the one of [metadata-default]
#   (the access set in a page header still takes precedence)
# lang: default lang of the pages, instead of the one of [metadata-default]
#   (french, auto/french...), also used for the searches in this source

# [source dad-botanic]
# root-tag: botanic
# access: family
# lang: english
